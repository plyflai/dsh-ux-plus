{
  "name": "dsh-ux-plus",
  "version": "0.1.0",
  "description": "让Deepseek Harness变得更顺手的各种小功能和UX增强包。",
  "license": "MIT",
  "author": "plyflai <277196217+plyflai@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plyflai/dsh-ux-plus.git",
    "directory": "."
  },
  "homepage": "https://github.com/plyflai/dsh-ux-plus",
  "bugs": {
    "url": "https://github.com/plyflai/dsh-ux-plus/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "client-plugin",
    "ui",
    "ux",
    "settings"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./ui-tweak": "./src/ui-tweak.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "src",
    "features",
    "lib",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "tsdown": "^0.22.2"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "tsdown && node scripts/build.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
